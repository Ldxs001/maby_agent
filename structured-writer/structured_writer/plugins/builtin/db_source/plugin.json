{
  "name": "db_source",
  "display_name": "数据库数据源",
  "desc": "对接 SQLite / CSV / MySQL / PostgreSQL 数据源，读取表格数据挂到子结构（只读，取什么由使用指令决定）",
  "module": "plugin_db_source",
  "class": "DbSourcePlugin",
  "input_fields": [
    {"key": "source_type", "label": "数据源类型", "type": "select",
     "options": [{"value": "sqlite", "label": "SQLite (.db)"},
                 {"value": "csv", "label": "CSV 文件"},
                 {"value": "mysql", "label": "MySQL"},
                 {"value": "postgresql", "label": "PostgreSQL"}],
     "required": true},
    {"key": "path", "label": "文件路径（csv/sqlite）", "type": "text",
     "hint": "如 C:/data/sales.db 或 data/sales.csv", "required": false},
    {"key": "host", "label": "主机（mysql/pg）", "type": "text", "required": false},
    {"key": "port", "label": "端口（mysql/pg）", "type": "text", "required": false},
    {"key": "user", "label": "账号（mysql/pg）", "type": "text", "required": false},
    {"key": "password", "label": "密码（mysql/pg，仅本次会话使用）", "type": "password", "required": false},
    {"key": "dbname", "label": "数据库名（mysql/pg）", "type": "text", "required": false},
    {"key": "table", "label": "表名（可选，留空自动取第一张非空表）", "type": "text", "required": false},
    {"key": "max_rows", "label": "最大行数（默认 100000）", "type": "text", "required": false}
  ],
  "output_types": ["table"]
}
